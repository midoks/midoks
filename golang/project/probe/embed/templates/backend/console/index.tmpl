{[template "backend/common/header.tmpl" .]}

<style>
    .dashboard-stat-value {
        font-size: 32px;
        font-weight: bold;
        color: #1890ff;
        line-height: 1.2;
    }
    
    .dashboard-stat-unit {
        font-size: 14px;
        color: #999;
        margin-left: 5px;
    }
    
    .dashboard-stat-label {
        font-size: 14px;
        color: #666;
        margin-top: 8px;
    }
    
    .dashboard-trend-up {
        color: #52c41a;
        font-size: 12px;
        margin-top: 4px;
    }
    
    .dashboard-trend-down {
        color: #f5222d;
        font-size: 12px;
        margin-top: 4px;
    }
    
    .stats-table {
        display: grid;
        grid-template-columns: repeat(5, 1fr);
        gap: 0;
        margin-bottom: 15px;
        border: 1px solid #e8e8e8;
        border-radius: 4px;
        overflow: hidden;
        row-gap: 0;
    }
    
    .stats-cell {
        border: 1px solid #e8e8e8;
        border-top: none;
        border-left: none;
        padding: 20px 15px;
        position: relative;
        min-height: 90px;
        background: #fff;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
    }
    
    .stats-cell:nth-child(-n+5) {
        border-top: 1px solid #e8e8e8;
    }
    
    .stats-cell:nth-child(5n+1) {
        border-left: 1px solid #e8e8e8;
    }
    
    .stats-cell .stat-label {
        position: absolute;
        top: 10px;
        left: 15px;
        font-size: 12px;
        color: #999;
    }
    
    .stats-cell .stat-value-wrap {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        margin-top: 15px;
    }
    
    .stats-cell .stat-value {
        font-size: 28px;
        font-weight: bold;
        color: #333;
        display: flex;
        align-items: baseline;
        justify-content: center;
        gap: 4px;
    }
    
    .stats-cell .stat-value .stat-number {
        color: #333;
    }
    
    .stats-cell .stat-value .stat-unit {
        font-size: 14px;
        color: #999;
        font-weight: normal;
    }
    
    .stats-cell .stat-trend-wrap {
        display: flex;
        align-items: center;
        gap: 8px;
        margin-top: 4px;
    }
    
    .stats-cell .stat-trend {
        font-size: 12px;
    }
    
    .stats-cell .stat-trend.up {
        color: #52c41a;
    }
    
    .stats-cell .stat-trend.down {
        color: #f5222d;
    }
    
    .stats-cell .stat-detail {
        font-size: 11px;
        color: #999;
        margin-top: 4px;
        text-align: center;
    }
    
    .stats-cell .refresh-icon {
        position: absolute;
        top: 10px;
        right: 15px;
        font-size: 14px;
        color: #1890ff;
        cursor: pointer;
    }
    
    .stats-cell.login-cell .stat-value-wrap {
        margin-top: 20px;
    }
    
    .stats-cell.login-cell .login-content {
        font-size: 13px;
        color: #333;
        font-weight: 500;
        text-align: center;
    }
    
    .stats-cell.login-cell .login-date {
        font-size: 12px;
        color: #999;
        margin-top: 4px;
    }
    
    @media screen and (max-width: 992px) {
        .stats-table {
            display: grid;
            grid-template-columns: repeat(2, 1fr);
            gap: 0;
            border: 1px solid #e8e8e8;
            border-radius: 4px;
            overflow: hidden;
            row-gap: 8px;
        }
        
        .stats-row {
            display: contents;
        }
        
        .stats-cell {
            border: 1px solid #e8e8e8;
            border-top: none;
            border-left: none;
        }
        
        .stats-row:first-child .stats-cell {
            border-top: 1px solid #e8e8e8;
        }
        
        .stats-cell:first-child {
            border-left: 1px solid #e8e8e8;
        }
        
        .stats-cell .stat-value {
            font-size: 24px;
        }
        
        .stats-cell:last-child:nth-child(odd) {
            grid-column: span 2;
        }
    }
    
    @media screen and (max-width: 480px) {
        .stats-table {
            grid-template-columns: 1fr;
        }
        
        .stats-cell:last-child:nth-child(odd) {
            grid-column: span 1;
        }
        
        .stats-cell .stat-value {
            font-size: 22px;
        }
    }
    
    .chart-container {
        height: 260px;
        width: 100%;
    }
    
    .chart-table {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
