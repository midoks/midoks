        margin-bottom: 0;
    }
    
    .chart-cell.map-cell .rank-progress-bar {
        height: 4px;
        background: #f0f0f0;
        border-radius: 2px;
        overflow: hidden;
        margin-bottom: 4px;
    }
    
    .chart-cell.map-cell .rank-progress-fill {
        height: 100%;
