{[template "backend/common/header.tmpl" .]}

<style>
    .stats-table {
        display: grid;
        grid-template-columns: repeat(5, 1fr);
        gap: 0;
        margin-top: 10px;
        border: 1px solid #e8e8e8;
        border-radius: 4px;
        overflow: hidden;
        background: #fff;
    }
    
    .stats-row {
        display: contents;
    }
    
    .stats-cell {
        border-right: 1px solid #e8e8e8;
        border-bottom: 1px solid #e8e8e8;
        padding: 20px 15px;
        position: relative;
        min-height: 90px;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
    }
    
    .stats-cell:nth-child(5n) {
        border-right: none;
    }
    
    .stats-row:last-child .stats-cell {
        border-bottom: none;
    }
    
    .stats-cell .stat-label {
        position: absolute;
        top: 10px;
        left: 15px;
        font-size: 12px;
        color: #999;
    }
    
    .stats-cell .stat-value-wrap {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        margin-top: 15px;
    }
    
    .stats-cell .stat-value {
        font-size: 22px;
        font-weight: bold;
        color: #333;
        display: flex;
        align-items: baseline;
        justify-content: center;
        gap: 4px;
    }
    
    .stats-cell .stat-value .stat-number {
        color: #333;
    }
    
    .stats-cell .stat-value .stat-unit {
        font-size: 12px;
        color: #999;
        font-weight: normal;
    }
    
    .stats-cell .stat-detail {
        font-size: 14px;
        color: #333;
        margin-top: 4px;
        text-align: center;
    }
    
    @media screen and (max-width: 992px) {
        .stats-table {
            display: flex;
            flex-direction: column;
            gap: 8px;
            border: none;
            border-radius: 0;
            overflow: visible;
        }
        
        .stats-row {
            display: grid;
            grid-template-columns: repeat(2, 1fr);
            gap: 0;
            border: 1px solid #e8e8e8;
            border-radius: 4px;
            overflow: hidden;
        }
        
        .stats-cell {
            border-right: 1px solid #e8e8e8;
            border-bottom: 1px solid #e8e8e8;
        }
        
        .stats-row .stats-cell:nth-child(2n) {
            border-right: none;
        }
        
        .stats-row:last-child .stats-cell {
            border-bottom: none;
        }
    }
    
    @media screen and (max-width: 480px) {
        .stats-row {
            grid-template-columns: 1fr;
        }
    }
</style>

<div class="layui-fluid">
    <div class="layui-col-md12" style="padding: 5px;">
        <div class="layui-card">
            <div class="layui-card-body">

                <div class="layui-tab layui-tab-brief">
                    <ul class="layui-tab-title" id="status">
                        {[range $menu := .submenu]}
                            <li data-status="{[$menu.Number]}" {[if eq (print "/" $.admin_path "/" $menu.Link) $.CurrentPath]}class="layui-this"{[end]}><a href="/{[$.admin_path]}/{[$menu.Link]}?cluster_id={[$.cluster_id]}"><i class="layui-icon {[$menu.Icon]}"></i> {[$menu.Name]}</a></li>
                        {[end]}
                    </ul>
                </div>

                <div class="cluster-boards">
                    <div class="stats-table">
                        <div class="stats-row">
                            <div class="stats-cell">
                                <div class="stat-label">集群</div>
                                <div class="stat-value-wrap">
                                    <div class="stat-value">
                                        <span class="stat-number">11</span>
                                        <span class="stat-unit">个</span>
                                    </div>
                                </div>
                            </div>
                            <div class="stats-cell">
                                <div class="stat-label">边缘节点</div>
                                <div class="stat-value-wrap">
                                    <div class="stat-value">
                                        <span class="stat-number">101</span>
                                        <span class="stat-unit">个</span>
                                    </div>
                                </div>
                            </div>
                            <div class="stats-cell">
                                <div class="stat-label">API节点</div>
                                <div class="stat-value-wrap">
                                    <div class="stat-value">
                                        <span class="stat-number">1</span>
                                        <span class="stat-unit">个</span>
                                    </div>
                                </div>
                            </div>
                            <div class="stats-cell">
                                <div class="stat-label">用户</div>
                                <div class="stat-value-wrap">
                                    <div class="stat-value">
                                        <span class="stat-number">7</span>
                                        <span class="stat-unit">个</span>
                                    </div>
                                </div>
                            </div>
                            <div class="stats-cell">
                                <div class="stat-label">网站</div>
                                <div class="stat-value-wrap">
                                    <div class="stat-value">
                                        <span class="stat-number">255</span>
                                        <span class="stat-unit">个</span>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="stats-row">
                            <div class="stats-cell">
                                <div class="stat-label">本周流量</div>
                                <div class="stat-value-wrap">
                                    <div class="stat-value">
                                        <span class="stat-number">12.55</span>
                                        <span class="stat-unit">TiB</span>
                                    </div>
                                </div>
                            </div>
                            <div class="stats-cell">
                                <div class="stat-label">昨日流量</div>
                                <div class="stat-value-wrap">
                                    <div class="stat-value">
                                        <span class="stat-number">2.4</span>
                                        <span class="stat-unit">TiB</span>
                                    </div>
                                </div>
                            </div>
                            <div class="stats-cell">
                                <div class="stat-label">当天独立IP</div>
                                <div class="stat-value-wrap">
                                    <div class="stat-value">
                                        <span class="stat-number">4,862,009</span>
                                    </div>
                                </div>
                            </div>
                            <div class="stats-cell">
                                <div class="stat-label">当天流量</div>
                                <div class="stat-value-wrap">
                                    <div class="stat-value">
                                        <span class="stat-number">1.35</span>
                                    </div>
                                </div>
                            </div>
                            <div class="stats-cell">
                                <div class="stat-label">上次登录</div>
                                <div class="stat-value-wrap">
                                    <div class="stat-detail">加拿大</div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- end -->
            </div>
        </div>
    </div>
</div>

