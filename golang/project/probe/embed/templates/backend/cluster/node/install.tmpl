{[template "backend/common/header.tmpl" .]}

<div class="layui-fluid">
    <div class="layui-col-md12" style="padding: 5px;">
        <div class="layui-card">
            <div class="layui-card-body">

                <div class="layui-tab layui-tab-brief">
                    <ul class="layui-tab-title" id="status">
                        {[range $menu := .submenu]}
                            <li data-status="{[$menu.Number]}" {[if eq (print "/" $.admin_path "/" $menu.Link) $.CurrentPath]}class="layui-this"{[end]}><a href="/{[$.admin_path]}/{[$menu.Link]}?cluster_id={[$.cluster_id]}&node_id={[$.node_id]}"><i class="layui-icon {[$menu.Icon]}"></i> {[$menu.Name]}</a></li>
                        {[end]}
                    </ul>
                </div>

                <div style="margin-top: 10px;">
                    <div class="layui-row">
                        <div class="layui-col-md12">
                            {[if .Data.IsInstalled]}
                            <div class="success">当前节点为已安装状态。</div>
                            {[else]}
                            <div class="fail">在当前节点完成安装前，相关请求将不会生效。</div>
                            {[end]}
                        </div>
                    </div>

                    <div class="layui-row layui-col-space15" style="margin-top:12px;">
                        <div class="layui-col-md12">

                            <div style="border:1px solid #e5e7eb;background:#fff;border-radius:8px;">
                                {[if not .Data.IsInstalled]}
                                <div style="padding:12px 16px;border-bottom:1px solid #f1f5f9;font-size:16px;color:#111827;">
                                    方法1：通过SSH自动安装
                                </div>
                                {[end]}
                                <div style="padding:16px;">

                                    {[if not .Data.IsInstalled]}
                                    <div style="display:block;align-items:center;gap:8px;margin-bottom:12px;">
                                        <div style="color:#374151;">SSH地址</div>
                                        <div style="color:#9ca3af;">
                                            <span>
                                            {[if .SshData ]}
                                                {[if gt .SshData.ID 0 ]}
                                                    {[with .SshData.GetParams ]}
                                                        {[.Host]}:{[.Port]}
                                                    {[end]}
                                                {[else]}
                                                    未设置
                                                {[end]}
                                            {[else]}
                                                未设置
                                            {[end]}
                                            </span>
                                            <a href="#" style="color:#1d4ed8;" onclick="Admin.open('修改SSH登录信息','/{[$.admin_path]}/clusters/ssh/node_pop_add?node_id={[.node_id]}',750,650)">[修改]</a>
                                        </div>
                                    </div>
                                    {[end]}

                                    <!--    
                                    <div style="border:1px solid #e5e7eb;background:#f8fafc;color:#374151;border-radius:6px;padding:10px 12px;margin-bottom:12px;">
                                        安装过程中发生错误： can not find node grant
                                    </div> 
                                    -->

                                    {[/* 安装过程中，显示进度条 */]}

                                    
                                    <form class="layui-form">
                                    {[if .Data.IsInstalled]}
                                        <button type="button" class="layui-btn layui-btn-primary" lay-filter="mod_reinstall" lay-submit>重新安装</button>
                                    {[else]}
                                        <button type="button" class="layui-btn layui-btn-primary" lay-filter="doinstall" lay-submit>开始安装</button>
                                    {[end]}
                                    </form>

                                    <div id="install-progress" style="display:none;margin-top:16px;">
                                        <div style="margin-bottom:8px;color:#374151;">安装进度</div>
                                        <div style="background:#e5e7eb;border-radius:6px;height:24px;overflow:hidden;">
                                            <div id="progress-bar" style="background:#1d4ed8;height:100%;width:0%;transition:width 0.3s;"></div>
                                        </div>
                                        <div id="progress-text" style="margin-top:8px;color:#6b7280;font-size:14px;">准备中...</div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="layui-row layui-col-space15" style="margin-top:12px;">
                        <div class="layui-col-md12">
                            <div style="border:1px solid #e5e7eb;background:#fff;border-radius:8px;">
                                {[if not .Data.IsInstalled]}
                                <div style="padding:12px 16px;border-bottom:1px solid #f1f5f9;font-size:16px;color:#111827;">
                                    方法2：手动安装
                                </div>
                                {[end]}
                                <div style="padding:16px;">
                                    <div style="margin-bottom:12px;">
                                        <div style="font-size:14px;color:#111827;margin-bottom:8px;">下载安装文件</div>
                                        <table class="layui-table">
                                            <colgroup>
                                                <col>
                                                <col width="120">
                                                <col width="120">
                                                <col width="100">
                                            </colgroup>
                                            <thead>
                                                <tr>
                                                    <th>文件名</th>
                                                    <th>操作系统</th>
                                                    <th>CPU架构</th>
                                                    <th>版本</th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                <tr>
                                                    <td><a href="#" style="color:#1d4ed8;">node-linux-amd64-v1.1.0.zip</a></td>
                                                    <td>Linux</td>
                                                    <td>x86_64</td>
                                                    <td>v1.1.0</td>
                                                </tr>
                                            </tbody>
                                        </table>
                                    </div>

                                    <div style="margin-bottom:12px;">
                                        <div style="font-size:14px;color:#111827;margin-bottom:8px;">配置文件 <span style="color:#6b7280;">configs/api_node.yaml</span> <a href="#" style="margin-left:8px;color:#1d4ed8;">下载</a></div>
                                        <pre style="background:#0b1021;color:#e5e7eb;padding:12px;border-radius:6px;overflow:auto;"><code>rpc.endpoints: [ "http://xxx:8001" ]
nodeId: "{[if .Data]}{[.Data.UniqueID]}{[end]}"
secret: "{[if .Data]}{[.Data.Secret]}{[end]}"</code></pre>
                                        <div style="color:#6b7280;margin-top:8px;">手动替换cloud-node安装目录下的 configs/api_node.yaml 文件，然后重新启动生效；如果文件不存在，则需要创建。</div>
                                    </div>

                                    <div style="margin-bottom:12px;">
                                        <div style="font-size:14px;color:#111827;margin-bottom:8px;">安装目录</div>
                                        <div style="border:1px solid #e5e7eb;background:#f8fafc;color:#374151;border-radius:6px;padding:10px 12px;">建议安装在 /usr/local/mgo/node</div>
                                    </div>


                                    {[if not .Data.IsInstalled]}
                                    <form class="layui-form">
                                            <button type="submit" class="layui-btn" lay-filter="mod_install" lay-submit>修改当前节点为已安装状态</button>
                                    </form>
                                    {[end]}
                                    
                                </div>
                            </div>
                        </div>
                    </div>
                </div>


                <!-- end -->
            </div>
        </div>
    </div>
</div>

<script type="text/javascript">

layui.config({base: '/static/layuiadmin/'}).use(['table','jquery','form'], function(){
///
var admin = layui.admin
,$ = layui.$
,form = layui.form
,table = layui.table;

var pollingInterval = null;

form.on("submit(mod_install)", function(data){
    var index = layer.load();
    var field = {
        "id": "{[.node_id]}",
        "is_installed": "1"
    };

    $.post("/{[$.admin_path]}/clusters/node/install_update_status", field, function(res) {
        layer.msg(res.msg, {
            icon: res.code > -1 ? 1 : 2,
            shift: 0,
            time: 2000
        }, function() {
            layer.close(index);
            if(res.code > -1){
                parent.location.reload();
            }
        });
    }, 'json');
    return false;
});

form.on("submit(mod_reinstall)", function(data){
    var index = layer.load();
    var field = {
        "id": "{[.node_id]}",
        "is_installed": "0"
    };

    $.post("/{[$.admin_path]}/clusters/node/install_update_status", field, function(res) {
        layer.msg(res.msg, {
            icon: res.code > -1 ? 1 : 2,
            shift: 0,
            time: 2000
        }, function() {
            layer.close(index);
            if(res.code > -1){
                parent.location.reload();
            }
        });
    }, 'json');
    return false;
});

form.on("submit(doinstall)", function(data){
    var index = layer.load();
    var field = {
        "id": "{[.node_id]}"
    };
    
    // 显示进度条
    $('#install-progress').show();
    $('#progress-bar').css('width', '0%');
    $('#progress-text').text('正在准备安装...');
    
    $.post("/{[$.admin_path]}/clusters/node/doinstall", field, function(res) {
        layer.close(index);
        if(res.code > -1){
            // 开始轮询获取安装状态
            startPolling();
        } else {
            layer.msg(res.msg, {
                icon: 2,
                shift: 6,
                time: 2000
            });
        }
    }, 'json').fail(function() {
        layer.close(index);
        $('#progress-bar').css('width', '0%');
        $('#progress-bar').css('background', '#ef4444');
        $('#progress-text').text('安装失败，请检查SSH配置和网络连接');
    });
    
    return false;
});

// 开始轮询获取安装状态
function startPolling() {
    var nodeId = "{[.node_id]}";
    
    // 清除之前的轮询
    if (pollingInterval) {
        clearInterval(pollingInterval);
    }
    
    // 开始轮询
    pollingInterval = setInterval(function() {
        $.get("/{[$.admin_path]}/clusters/node/install_status", {node_id: nodeId}, function(res) {
            if(res.code > -1 && res.data) {
                var status = res.data;
                
                // 更新进度条
                $('#progress-bar').css('width', status.progress + '%');
                $('#progress-text').text(status.message);
                
                // 根据状态更新进度条颜色
                if (status.status === 'failed') {
                    $('#progress-bar').css('background', '#ef4444');
                    clearInterval(pollingInterval);
                    layer.msg('安装失败: ' + status.message, {
                        icon: 2,
                        shift: 6,
                        time: 3000
                    });
                } else if (status.status === 'success') {
                    $('#progress-bar').css('background', '#22c55e');
                    clearInterval(pollingInterval);
                    layer.msg('安装成功完成！', {
                        icon: 1,
                        shift: 0,
                        time: 2000
                    }, function() {
                        parent.location.reload();
                    });
                }
            }
        }, 'json').fail(function() {
            clearInterval(pollingInterval);
            layer.msg('获取安装状态失败', {
                icon: 2,
                shift: 6,
                time: 2000
            });
        });
    }, 1000); // 每秒轮询一次
}

///
});
</script>


{[template "backend/common/footer.tmpl" .]}
