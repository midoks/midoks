{[template "backend/common/header.tmpl" .]}

<div class="layui-fluid">
    <div class="layui-col-md12" style="padding: 5px;">
        <div class="layui-card">
            <div class="layui-card-body">

                <div class="layui-tab layui-tab-brief">
                    <ul class="layui-tab-title" id="status">
                        <li data-status="1"><a href="/{[.admin_path]}/clusters">集群</a></li>
                        <li data-status="2" class="layui-this">节点</li>
                        <li data-status="3"><a href="/{[.admin_path]}/clusters/create">创建集群</a></li>
                    </ul>
                </div>

                <div class="layui-form toolbar" style="margin-top: 10px;margin-bottom: 10px;">
                <form class="layui-form" action="" id="node_form" onclick="return false;">

                    <div class="layui-inline mr0">
                        <div class="layui-input-inline mr0">
                            <input type="text" name="key" placeholder="集群、节点关键词" autocomplete="off" class="layui-input h30" value="">
                        </div>
                    </div>
                

                    <div class="layui-inline mr0">
                        <button class="layui-btn layui-btn-sm" id="table-sreach" data-id="list" lay-submit lay-filter="table-sreach"><i class="layui-icon">&#xe615;</i>搜索
                        </button>
                    </div>
                </form>
                </div>

                <div id="list"></div>

            </div>
        </div>
    </div>
</div>

<script type="text/javascript">

layui.config({base: '/static/layuiadmin/'}).use(['table','jquery'], function(){
///
var admin = layui.admin
,$ = layui.$
,form = layui.form
,table = layui.table;


table.render({
    elem: '#list',
    url: '/{[.admin_path]}/clusters/node/list',
    title: '数据表',
    cols: [[
        {field:'name', title:'节点名称', minWidth: 150},
        {title:'节点状态', width: 150, templet: '#statusTpl'},
        {title:'操作', toolbar: '#cmdTpl', width: 160, fixed: 'right'}
     ]],
    page: true
});


table.on('tool(list)', function(obj){
    switch(obj.event){
    };
});

table.on('toolbar', function(obj){
    switch(obj.event){
    };
});
///
});
</script>


<script type="text/html" id="cmdTpl">
    <a class="layui-btn layui-btn-xs layui-btn-primary" 
        href="/{[.admin_path]}/clusters/cluster/settings?cluster_id={{d.id}}">
        <i class="layui-icon layui-icon-set"></i>详情
    </a>
</script>
{[template "backend/common/footer.tmpl" .]}